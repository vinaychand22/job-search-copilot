# Pick ONE provider and fill in its lines. See docs/SETUP.md for how to get each key.
# Never commit .env (it's in .gitignore) and never paste a key into chat or code.

# --- Option A: Google Gemini (free tier, good for development; don't send personal email here) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
FAST_MODEL=gemini-3.8-flash
SMART_MODEL=gemini-3.8-flash

# --- Option B: Ollama, local and private (free; runs on your Mac) ---
# LLM_PROVIDER=ollama
# FAST_MODEL=llama3.1:8b
# SMART_MODEL=llama3.1:8b

# --- Option C: OpenAI (paid, from $5 prepaid) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# FAST_MODEL=gpt-5-mini
# SMART_MODEL=gpt-5-mini

# --- Option D: Azure OpenAI (model = your deployment name) ---
# LLM_PROVIDER=azure
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# FAST_MODEL=<deployment-name>
# SMART_MODEL=<deployment-name>

# --- Option E: Anthropic Claude ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# FAST_MODEL=claude-haiku-5-5
# SMART_MODEL=claude-sonnet-5-5
